0 // 4x4 footprint tower: two 2x4 bricks side by side per layer
0 // 5 bottom layers in dark bluish grey, top layer in red
0 // Y values: 0, -24, -48, -72, -96, -120 (6 layers)

0 // Layer 1 (bottom) - Dark Bluish Grey
0 // Brick A at z=-20 covers stud rows z=-30 and z=-10
1 72 0 0 -20 1 0 0 0 1 0 0 0 1 3001.dat
0 // Brick B at z=+20 covers stud rows z=+10 and z=+30
1 72 0 0 20 1 0 0 0 1 0 0 0 1 3001.dat
0 STEP

0 // Layer 2 - Dark Bluish Grey
1 72 0 -24 -20 1 0 0 0 1 0 0 0 1 3001.dat
1 72 0 -24 20 1 0 0 0 1 0 0 0 1 3001.dat
0 STEP

0 // Layer 3 - Dark Bluish Grey
1 72 0 -48 -20 1 0 0 0 1 0 0 0 1 3001.dat
1 72 0 -48 20 1 0 0 0 1 0 0 0 1 3001.dat
0 STEP

0 // Layer 4 - Dark Bluish Grey
1 72 0 -72 -20 1 0 0 0 1 0 0 0 1 3001.dat
1 72 0 -72 20 1 0 0 0 1 0 0 0 1 3001.dat
0 STEP

0 // Layer 5 - Dark Bluish Grey
1 72 0 -96 -20 1 0 0 0 1 0 0 0 1 3001.dat
1 72 0 -96 20 1 0 0 0 1 0 0 0 1 3001.dat
0 STEP

0 // Layer 6 (top) - Red
1 4 0 -120 -20 1 0 0 0 1 0 0 0 1 3001.dat
1 4 0 -120 20 1 0 0 0 1 0 0 0 1 3001.dat
0 STEP
