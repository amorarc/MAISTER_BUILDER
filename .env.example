# Copy to .env and fill in. .env is gitignored.
#
# A HuggingFace token with the "Make calls to Inference Providers" permission.
# Create one at https://huggingface.co/settings/tokens
#
# This is only one of the places the token is looked for. In order:
#   1. HF_TOKEN environment variable
#   2. HUGGINGFACE_TOKEN environment variable
#   3. this file
#   4. ~/.cache/huggingface/token  (written by `huggingface-cli login`)
HF_TOKEN=<your-token-here>

# ---- Optional overrides (defaults shown in maister/agent/config.py) ----
# LDRAW_AGENT_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731:cheapest
# LDRAW_VISION=1                 # 0 disables the render-and-look channel
# LDRAW_PARALLEL_SUBBUILDS=6     # objects built at once
# LDRAW_CRITIQUE_ROUNDS=0        # see PROJECT.md, finding 2
